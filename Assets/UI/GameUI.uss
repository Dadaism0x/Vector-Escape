/* ── Score ─────────────────────────────────────────────────────────────────── */

#ScoreContainer {
    align-self: center;
    margin-top: 12px;
    align-items: center;
    background-color: rgba(12, 6, 28, 0.65);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 3px;
    padding-bottom: 4px;
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 1px;
    border-bottom-color: rgba(203, 166, 243, 0.45);
}

#ScoreTitle {
    font-size: 8px;
    color: rgba(180, 145, 225, 0.55);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    align-self: center;
}

#ScoreLabel {
    font-size: 20px;
    color: rgb(220, 195, 255);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    align-self: center;
}

/* ── Game Over Overlay ────────────────────────────────────────────────────── */

#GameOverOverlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    background-color: rgba(3, 1, 10, 0.75);
    display: none;
}

#GameOverCard {
    width: 260px;
    flex-direction: column;
    background-color: rgba(5, 2, 13, 0.97);
    border-top-left-radius: 14px;
    border-top-right-radius: 14px;
    border-bottom-right-radius: 14px;
    border-bottom-left-radius: 14px;
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-left-color: rgba(112, 80, 180, 0.45);
    border-right-color: rgba(112, 80, 180, 0.45);
    border-top-color: rgba(112, 80, 180, 0.45);
    border-bottom-color: rgba(112, 80, 180, 0.45);
    padding-left: 20px;
    padding-right: 20px;
    padding-top: 14px;
    padding-bottom: 14px;
    align-items: stretch;
}

#GameOverTitle {
    font-size: 9px;
    color: rgba(180, 145, 225, 0.55);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    align-self: center;
    margin-bottom: 2px;
}

#FinalScore {
    font-size: 30px;
    color: rgb(220, 195, 255);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    align-self: center;
    margin-bottom: 8px;
}

#CardDivider {
    height: 1px;
    background-color: rgba(112, 80, 180, 0.30);
    margin-bottom: 8px;
}

#LeaderboardRows {
    flex-direction: column;
    flex-shrink: 0;
    margin-bottom: 12px;
}

/* ── Leaderboard rows ─────────────────────────────────────────────────────── */

.lb-row {
    flex-direction: row;
    flex-shrink: 0;
    align-items: center;
    min-height: 24px;
    padding-left: 2px;
    padding-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    margin-bottom: 2px;
}

.lb-row--current {
    background-color: rgba(255, 219, 130, 0.07);
}

.lb-rank {
    width: 20px;
    font-size: 11px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: rgb(171, 230, 204);
}

.lb-name {
    flex-grow: 2;
    flex-shrink: 1;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    color: rgb(250, 242, 223);
    overflow: hidden;
}

.lb-dots {
    flex-grow: 1;
    flex-shrink: 1;
    font-size: 8px;
    -unity-text-align: middle-center;
    color: rgba(250, 242, 223, 0.16);
    overflow: hidden;
}

.lb-score {
    width: 46px;
    font-size: 12px;
    -unity-font-style: bold;
    -unity-text-align: middle-right;
    color: rgb(250, 242, 223);
}

/* ── Change Name Button ───────────────────────────────────────────────────── */

#ChangeNameButton {
    align-self: center;
    background-color: rgba(0, 0, 0, 0);
    border-left-width: 0;
    border-right-width: 0;
    border-top-width: 0;
    border-bottom-width: 0;
    color: rgba(180, 145, 225, 0.50);
    font-size: 10px;
    -unity-font-style: bold;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 4px;
    padding-bottom: 4px;
    margin-top: 5px;
    transition-property: color;
    transition-duration: 0.12s;
}

#ChangeNameButton:hover {
    color: rgba(210, 185, 255, 0.80);
}

#ChangeNameButton:active {
    color: rgba(150, 110, 220, 0.90);
}

/* ── Restart Button ───────────────────────────────────────────────────────── */

#RestartButton {
    align-self: center;
    background-color: rgba(18, 10, 38, 0.88);
    border-left-color: rgb(180, 140, 255);
    border-right-color: rgb(180, 140, 255);
    border-top-color: rgb(180, 140, 255);
    border-bottom-color: rgb(180, 140, 255);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    color: rgb(210, 185, 255);
    font-size: 15px;
    -unity-font-style: bold;
    padding-left: 42px;
    padding-right: 42px;
    padding-top: 10px;
    padding-bottom: 10px;
    transition-property: background-color, border-left-color, border-right-color, border-top-color, border-bottom-color, color;
    transition-duration: 0.15s, 0.15s, 0.15s, 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease, ease, ease, ease, ease, ease;
}

#RestartButton:hover {
    background-color: rgba(70, 40, 130, 0.92);
    border-left-color: rgb(230, 210, 255);
    border-right-color: rgb(230, 210, 255);
    border-top-color: rgb(230, 210, 255);
    border-bottom-color: rgb(230, 210, 255);
    color: rgb(240, 230, 255);
}

#RestartButton:active {
    background-color: rgba(40, 20, 80, 0.95);
    border-left-color: rgb(150, 110, 220);
    border-right-color: rgb(150, 110, 220);
    border-top-color: rgb(150, 110, 220);
    border-bottom-color: rgb(150, 110, 220);
    color: rgb(180, 155, 230);
}

/* ── Start Overlay ────────────────────────────────────────────────────────── */

#StartOverlay {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    background-color: rgba(5, 3, 15, 0.6);
}

#GameTitle {
    font-size: 22px;
    color: rgb(220, 195, 255);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 4px;
}

#NamePrompt {
    font-size: 9px;
    color: rgba(180, 145, 225, 0.6);
    -unity-font-style: bold;
    -unity-text-align: upper-center;
    margin-bottom: 14px;
}

#NicknameField {
    width: 160px;
    margin-bottom: 14px;
}

#NicknameField .unity-label {
    display: none;
}

#NicknameField .unity-base-text-field__input {
    background-color: rgba(18, 10, 38, 0.88);
    border-left-color: rgb(160, 120, 240);
    border-right-color: rgb(160, 120, 240);
    border-top-color: rgb(160, 120, 240);
    border-bottom-color: rgb(160, 120, 240);
    border-left-width: 2px;
    border-right-width: 2px;
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
    color: rgb(210, 185, 255);
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    padding-left: 12px;
    padding-right: 12px;
    padding-top: 8px;
    padding-bottom: 8px;
}

#StartButton {
    align-self: center;
    background-color: rgba(18, 10, 38, 0.88);
    border-left-color: rgb(180, 140, 255);
    border-right-color: rgb(180, 140, 255);
    border-top-color: rgb(180, 140, 255);
    border-bottom-color: rgb(180, 140, 255);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    color: rgb(210, 185, 255);
    font-size: 15px;
    -unity-font-style: bold;
    padding-left: 42px;
    padding-right: 42px;
    padding-top: 10px;
    padding-bottom: 10px;
    transition-property: background-color, border-left-color, border-right-color, border-top-color, border-bottom-color, color;
    transition-duration: 0.15s, 0.15s, 0.15s, 0.15s, 0.15s, 0.15s;
    transition-timing-function: ease, ease, ease, ease, ease, ease;
}

#StartButton:hover {
    background-color: rgba(70, 40, 130, 0.92);
    border-left-color: rgb(230, 210, 255);
    border-right-color: rgb(230, 210, 255);
    border-top-color: rgb(230, 210, 255);
    border-bottom-color: rgb(230, 210, 255);
    color: rgb(240, 230, 255);
}

#StartButton:active {
    background-color: rgba(40, 20, 80, 0.95);
    border-left-color: rgb(150, 110, 220);
    border-right-color: rgb(150, 110, 220);
    border-top-color: rgb(150, 110, 220);
    border-bottom-color: rgb(150, 110, 220);
    color: rgb(180, 155, 230);
}
